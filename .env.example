# Crafty Art SEO Management Dashboard - Environment Variables Configuration

# ----------------- APPLICATION & DATABASE -----------------
PROJECT_NAME="Crafty Art SEO Management Dashboard"
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/crafty_art_seo
# For local dev / test: sqlite:///./crafty_art_seo.db
DATABASE_URL=sqlite:///./crafty_art_seo.db

# ----------------- SECURITY & JWT -----------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------- GOOGLE SEARCH CONSOLE OAUTH 2.0 -----------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:5173/gsc-connection or https://your-domain.com/gsc-connection
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/gsc-connection
GSC_READONLY_SCOPE=https://www.googleapis.com/auth/webmasters.readonly

# ----------------- BACKGROUND SCHEDULER -----------------
# 24-hour UTC format (default: 3 AM daily)
DAILY_SYNC_HOUR=3
