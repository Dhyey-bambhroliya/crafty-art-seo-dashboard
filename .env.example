# =====================================================================
# Crafty Art SEO Management Dashboard - Backend Environment Template
# =====================================================================
# INSTRUCTIONS:
# 1. DO NOT commit real secrets or production passwords to GitHub.
# 2. For local development, copy this file to .env and adjust values.
# 3. For production deployment on Render, configure these in Render Dashboard -> Environment.

# ----------------- APPLICATION & DATABASE -----------------
PROJECT_NAME="Crafty Art SEO Management Dashboard"

# Database Connection:
# Local Development (SQLite):
#   DATABASE_URL=sqlite:///./crafty_art_seo.db
# Production Supabase PostgreSQL (Session Pooler - Port 5432 or 6543):
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#   Note: If your database password contains special characters (e.g. @, #, :), URL-encode them (e.g. @ -> %40).
DATABASE_URL=sqlite:///./crafty_art_seo.db

# ----------------- SECURITY & JWT AUTHENTICATION -----------------
# Generate a strong 64-character random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------- FRONTEND & CORS CONFIGURATION -----------------
# Production Vercel URL (used for CORS allowlist):
FRONTEND_URL=https://crafty-art-seo-dashboard.vercel.app

# Optional: Add any extra comma-separated origins if needed:
# ADDITIONAL_CORS_ORIGINS=https://preview.vercel.app,http://192.168.1.100:5173

# ----------------- GOOGLE SEARCH CONSOLE OAUTH 2.0 -----------------
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized Redirect URIs in Google Cloud Console:
#   - http://localhost:5173/gsc-connection (for local dev)
#   - https://crafty-art-seo-dashboard.vercel.app/gsc-connection (for production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crafty-art-seo-dashboard.vercel.app/gsc-connection
GSC_READONLY_SCOPE=https://www.googleapis.com/auth/webmasters.readonly

# ----------------- BACKGROUND SCHEDULER -----------------
# Set to true to enable automated daily synchronization
ENABLE_SCHEDULER=true

# 24-hour UTC format (default: 3 AM UTC daily)
DAILY_SYNC_HOUR=3
